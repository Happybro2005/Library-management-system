# Server Configuration
PORT=5000
NODE_ENV=development

# Database Connection (PostgreSQL)
# For the local dedicated PostgreSQL instance started for this project:
DATABASE_URL="postgresql://postgres@localhost:5433/library_db?schema=public"
# If using a standard system PostgreSQL with password on default port 5432:
# DATABASE_URL="postgresql://postgres:your_password@localhost:5432/library_db?schema=public"

# Authentication & Session Security
SESSION_SECRET="super-secure-lms-admin-session-secret-key-32-chars-min"
COOKIE_SECRET="super-secure-lms-admin-cookie-secret-key-32-chars-min"

# Initial Administrator Seed Credentials (Used by seed script)
INITIAL_ADMIN_EMAIL="admin@library.local"
INITIAL_ADMIN_USERNAME="admin"
INITIAL_ADMIN_PASSWORD="AdminPassword123!"
INITIAL_ADMIN_NAME="System Administrator"

# File Upload Directory
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE_MB=50
